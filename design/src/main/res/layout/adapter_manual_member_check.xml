<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable
            name="name"
            type="java.lang.String" />
        <variable
            name="subtitle"
            type="java.lang.String" />
        <variable
            name="checked"
            type="boolean" />
        <variable
            name="clicked"
            type="android.view.View.OnClickListener" />
        <variable
            name="moveUp"
            type="android.view.View.OnClickListener" />
        <variable
            name="moveDown"
            type="android.view.View.OnClickListener" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="48dp"
        android:onClick="@{clicked}"
        android:paddingHorizontal="@dimen/item_header_margin"
        android:paddingVertical="4dp">

        <RadioButton
            android:id="@+id/check_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:checked="@{checked}"
            android:clickable="false"
            android:focusable="false" />

        <LinearLayout
            android:id="@+id/text_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/check_view"
            android:layout_toStartOf="@id/move_area"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{name}"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{subtitle}"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/move_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/up_view"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/manual_move_up"
                android:onClick="@{moveUp}"
                android:scaleType="centerInside"
                android:src="@drawable/ic_baseline_expand_less"
                android:visibility="@{moveUp != null ? android.view.View.VISIBLE : android.view.View.GONE}" />

            <ImageView
                android:id="@+id/down_view"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/manual_move_down"
                android:onClick="@{moveDown}"
                android:rotation="180"
                android:scaleType="centerInside"
                android:src="@drawable/ic_baseline_expand_less"
                android:visibility="@{moveDown != null ? android.view.View.VISIBLE : android.view.View.GONE}" />
        </LinearLayout>
    </RelativeLayout>
</layout>
