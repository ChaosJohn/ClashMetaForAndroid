<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="master"
            type="com.github.kr328.clash.design.ProfilesDesign" />
        <variable
            name="self"
            type="android.app.Dialog" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dialog_padding"
            android:text="@string/manual_config"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dialog_padding"
            android:text="@string/manual_config_summary"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption" />

        <com.github.kr328.clash.design.view.LargeActionLabel
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="@{() -> master.requestManualProxies(self)}"
            android:padding="@dimen/bottom_sheet_menu_items_padding"
            app:icon="@drawable/ic_baseline_dns"
            app:subtext="@string/manual_proxies_summary"
            app:text="@string/manual_proxies" />

        <com.github.kr328.clash.design.view.LargeActionLabel
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="@{() -> master.requestManualProxyGroups(self)}"
            android:padding="@dimen/bottom_sheet_menu_items_padding"
            app:icon="@drawable/ic_baseline_apps"
            app:subtext="@string/manual_proxy_groups_summary"
            app:text="@string/manual_proxy_groups" />

        <com.github.kr328.clash.design.view.LargeActionLabel
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="@{() -> master.requestManualRules(self)}"
            android:padding="@dimen/bottom_sheet_menu_items_padding"
            app:icon="@drawable/ic_baseline_rule"
            app:subtext="@string/manual_rules_summary"
            app:text="@string/manual_rules" />

        <com.github.kr328.clash.design.view.LargeActionLabel
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="@{() -> master.requestManualImport(self)}"
            android:padding="@dimen/bottom_sheet_menu_items_padding"
            app:icon="@drawable/ic_baseline_get_app"
            app:subtext="@string/manual_import_summary"
            app:text="@string/manual_import" />

        <com.github.kr328.clash.design.view.LargeActionLabel
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="@{() -> master.requestManualExport(self)}"
            android:padding="@dimen/bottom_sheet_menu_items_padding"
            app:icon="@drawable/ic_baseline_publish"
            app:subtext="@string/manual_export_summary"
            app:text="@string/manual_export" />
    </LinearLayout>
</layout>
