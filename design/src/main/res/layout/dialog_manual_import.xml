<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="master"
            type="com.github.kr328.clash.design.ProfilesDesign" />
        <variable
            name="self"
            type="android.app.Dialog" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dialog_padding"
            android:text="@string/manual_import"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

        <com.github.kr328.clash.design.view.LargeActionLabel
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="@{() -> master.requestManualImportQr(self)}"
            android:padding="@dimen/bottom_sheet_menu_items_padding"
            app:icon="@drawable/baseline_qr_code_scanner"
            app:subtext="@string/manual_import_from_qr_summary"
            app:text="@string/manual_import_from_qr" />

        <com.github.kr328.clash.design.view.LargeActionLabel
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="@{() -> master.requestManualImportImage(self)}"
            android:padding="@dimen/bottom_sheet_menu_items_padding"
            app:icon="@drawable/ic_outline_inbox"
            app:subtext="@string/manual_import_from_image_summary"
            app:text="@string/manual_import_from_image" />

        <com.github.kr328.clash.design.view.LargeActionLabel
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="@{() -> master.requestManualImportFile(self)}"
            android:padding="@dimen/bottom_sheet_menu_items_padding"
            app:icon="@drawable/ic_outline_folder"
            app:subtext="@string/manual_import_from_file_summary"
            app:text="@string/manual_import_from_file" />
    </LinearLayout>
</layout>
